# Comma-separated targets. Each is "url" or "Label=url".
TARGETS=Dinheirama=https://dinheirama.antonio-code.duckdns.org,Catalogo=https://catalogo.antonio-code.duckdns.org
CHECK_INTERVAL_MS=60000
CHECK_TIMEOUT_MS=10000
TLS_WARN_DAYS=14
HISTORY_LEN=60
PORT=3000
# Optional — alerts on up/down transition and TLS expiry:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
